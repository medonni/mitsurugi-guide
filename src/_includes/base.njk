<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ description or 'A fan-made Yu-Gi-Oh! guide covering multiple Ritual and combo decks: card compendiums grouped by where each card activates, step-by-step combo lines, and shared engine references.' }}">
  <link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ description or 'A fan-made Yu-Gi-Oh! guide covering multiple Ritual and combo decks: card compendiums grouped by where each card activates, step-by-step combo lines, and shared engine references.' }}">
  <meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
  <meta property="og:image" content="{{ site.origin }}{{ site.ogImage | url }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {# Only the weights the CSS actually sets. Space Grotesk 500 was requested and
     never used anywhere: it's a whole extra font file per page load for nothing.
     Adding a weight here means using it in style.css, and vice versa. #}
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body class="page-{{ bg or 'landing' }}{% if brand %} deck-{{ brand.id }}{% endif %}">
  {# The nav is four dropdown groups (18 links in the mobile sheet), and it
     comes before the content on every page. Keyboard and screen-reader users
     need one key to get past it. #}
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a href="{{ '/' | url }}" class="brand" aria-label="{{ site.name }}, back to all decks">
      <span class="diamond brand-mark"><span>{{ brand.glyph if brand else "M" }}</span></span>
      <span class="wordmark">{{ brand.wordmark if brand else site.neutralWordmark }}</span>
    </a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <nav class="nav" id="site-nav">
      {% for d in hub.decks %}
      <div class="nav-group{% if brand and brand.id == d.id %} active{% endif %}">
        <a href="{{ d.href | url }}">{{ d.name }}{% if d.status == "wip" %} <span class="nav-wip">WIP</span>{% endif %}</a>
        <button class="nav-caret" aria-haspopup="true" aria-expanded="false" aria-label="{{ d.name }} pages">
          <span class="chev" aria-hidden="true"></span>
        </button>
        <div class="nav-sub">
          <a href="{{ d.href | url }}">Overview</a>
          <a href="{{ (d.href ~ 'cards/') | url }}">Cards</a>
          <a href="{{ (d.href ~ 'combos/') | url }}">Combos</a>
          {% if d.discord %}<a href="{{ d.discord }}" target="_blank" rel="noopener">Discord</a>{% endif %}
        </div>
      </div>
      {% endfor %}
      {# Shared reference, not a deck: same group shape as the decks above so the
         dropdown behaviour and mobile accordion come for free. #}
      <div class="nav-group{% if nav == 'handtraps' or nav == 'handtraps-matchups' %} active{% endif %}">
        <a href="{{ '/handtraps/' | url }}">Handtraps</a>
        <button class="nav-caret" aria-haspopup="true" aria-expanded="false" aria-label="Handtraps pages">
          <span class="chev" aria-hidden="true"></span>
        </button>
        <div class="nav-sub">
          <a href="{{ '/handtraps/' | url }}">Reference</a>
          <a href="{{ '/handtraps/matchups/' | url }}">Matchups</a>
        </div>
      </div>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="mono">{{ site.neutralWordmark }} · fan-made resource<br>Card names &amp; effects © Konami, used for reference only.<br>Card data &amp; images courtesy of <a class="clink" href="https://ygoprodeck.com" target="_blank" rel="noopener">YGOPRODeck</a>. Thanks for the awesome API!<br>Looking for another deck's community? Check the <a class="clink" href="https://www.reddit.com/r/yugioh/wiki/discordrepository" target="_blank" rel="noopener">r/yugioh Discord repository</a>.</div>
  </footer>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Card image">
    <button type="button" class="lightbox-close" aria-label="Close card image">✕</button>
    <!-- impeccable-disable-next-line broken-image -- JS-populated preview img (lightbox script below sets src/alt on open); empty at rest by design -->
    <img alt="">
  </div>

  <!-- impeccable-disable-next-line broken-image -- JS-populated preview img (card-hover script below sets src/alt on show); empty at rest by design -->
  <div class="cardhover" id="cardhover" aria-hidden="true"><a href="#" tabindex="-1"><img alt=""><span class="cardhover-cta">Open card page →</span></a></div>

  <script>
    // Tap/click any card image to view it full size. ponytail: one delegated
    // listener, no per-image wiring, works for lazily-rendered cards too.
    (function () {
      const lb = document.getElementById("lightbox");
      if (!lb) return;
      const img = lb.querySelector("img");
      const closeBtn = lb.querySelector(".lightbox-close");
      // It declares role="dialog" aria-modal="true", so it has to behave like
      // one: focus moves in, Tab can't wander out behind it, and focus returns
      // to whatever opened it.
      let opener = null;
      const open = (el) => {
        img.src = el.currentSrc || el.src;
        img.alt = el.alt || "";
        opener = el;
        lb.classList.add("open");
        closeBtn.focus();
      };
      const close = () => {
        if (!lb.classList.contains("open")) return;
        lb.classList.remove("open");
        img.removeAttribute("src");
        if (opener) { opener.focus(); opener = null; }
      };
      document.addEventListener("click", (e) => {
        const z = e.target.closest(".zoomable");
        if (z) { open(z); return; }
        if (e.target.closest("#lightbox")) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") return close();
        // Only one focusable inside, so the trap is just "keep focus on it".
        if (e.key === "Tab" && lb.classList.contains("open")) { e.preventDefault(); closeBtn.focus(); return; }
        const a = document.activeElement;
        if ((e.key === "Enter" || e.key === " ") && a && a.classList.contains("zoomable")) { e.preventDefault(); open(a); }
      });
    })();
  </script>
  <script>
    // Card-name preview. Mouse: hover/focus shows a pass-through preview, click
    // follows the link. Touch: a tap ALWAYS opens the card art with an "Open card
    // page" CTA (the name never redirects); tap the art to go to the card, tap
    // elsewhere to dismiss. Touch is detected per-tap (touchstart recency +
    // pointerType), and the popover fully resets on hide so a stale invisible
    // popover can never intercept a later tap. ponytail: one shared popover.
    (function () {
      const box = document.getElementById("cardhover");
      // Any anchor that names a card carries data-img and gets the same
      // hover/tap preview: .clink (tips/combo steps), .gold (prose emphasis),
      // and the matchup map's handtrap chips. Keyed on the attribute rather
      // than the class list so a new kind of card link doesn't have to be
      // registered here to work.
      const links = document.querySelectorAll("a[data-img]");
      if (!box || !links.length) return;
      const img = box.querySelector("img");
      const link = box.querySelector("a");
      let touchedAt = 0;
      const touchedRecently = () => Date.now() - touchedAt < 700;

      const show = (el, interactive) => {
        img.src = el.dataset.img;
        link.href = el.getAttribute("href");
        box.classList.toggle("tap", !!interactive);   // interactive + CTA on touch
        // In tap mode the popover's link is the ONLY way to reach the card, so
        // it must not stay hidden from assistive tech: a screen-reader user who
        // activates a card name would otherwise get a cancelled link and no
        // announced replacement.
        box.setAttribute("aria-hidden", interactive ? "false" : "true");
        link.tabIndex = interactive ? 0 : -1;
        const r = el.getBoundingClientRect();
        box.classList.add("show");            // show first so we can measure height
        const w = box.offsetWidth, h = box.offsetHeight, m = 8;
        box.style.left = Math.min(Math.max(m, r.left), innerWidth - w - m) + "px";
        const above = r.top - h - m;
        box.style.top = (above < m ? r.bottom + m : above) + "px";
      };
      // Drop "tap" too: a hidden popover must not stay pointer-events:auto and
      // hijack a later tap that lands where it used to be.
      const hide = () => {
        box.classList.remove("show", "tap");
        box.setAttribute("aria-hidden", "true");
        link.tabIndex = -1;
      };

      document.addEventListener("touchstart", (e) => {
        touchedAt = Date.now();
        // A new touch outside the popover dismisses it first, so an open preview
        // can never sit over (and steal the tap of) the link beneath it.
        if (!e.target.closest("#cardhover")) hide();
      }, { passive: true, capture: true });

      links.forEach((el) => {
        el.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") show(el, false); });
        el.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") hide(); });
        el.addEventListener("focus", () => { if (!touchedRecently()) show(el, false); });
        el.addEventListener("blur", () => { if (!touchedRecently()) hide(); });
        el.addEventListener("click", (e) => {
          const touch = (e.pointerType && e.pointerType !== "mouse") || touchedRecently();
          if (touch) { e.preventDefault(); show(el, true); }   // touch: preview only; navigate via the popover
        });
      });
      document.addEventListener("click", (e) => {
        // Same selector as `links`: a tap on a card link must not be dismissed
        // by the document handler that runs right after its own show().
        if (!e.target.closest("a[data-img]") && !e.target.closest("#cardhover")) hide();
      });
      window.addEventListener("scroll", hide, { passive: true });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") hide(); });
    })();
  </script>
  <script>
    // Mobile nav toggle. ponytail: one button flips a class + aria; CSS does the rest.
    (function () {
      const btn = document.querySelector(".nav-toggle");
      const nav = document.getElementById("site-nav");
      if (!btn || !nav) return;
      const set = (open) => { nav.classList.toggle("open", open); btn.setAttribute("aria-expanded", open); };
      btn.addEventListener("click", () => set(nav.classList.contains("open") ? false : true));
      nav.addEventListener("click", (e) => { if (e.target.closest("a")) set(false); });
    })();
  </script>
  <script>
    // Nav-group caret: a tap target separate from the deck link itself, so a
    // touch device with no :hover (tablets >=900px) can still reach the
    // Cards/Combos/Discord dropdown instead of the link navigating away
    // immediately. Desktop keeps working via CSS-only :hover/:focus-within;
    // this only adds an explicit open path on top of that.
    (function () {
      const carets = document.querySelectorAll(".nav-caret");
      if (!carets.length) return;
      const closeAll = (except) => {
        carets.forEach((c) => {
          if (c === except) return;
          c.setAttribute("aria-expanded", "false");
          c.closest(".nav-group").classList.remove("open");
        });
      };
      carets.forEach((caret) => {
        caret.addEventListener("click", () => {
          const group = caret.closest(".nav-group");
          const open = !group.classList.contains("open");
          closeAll(open ? caret : null);
          group.classList.toggle("open", open);
          caret.setAttribute("aria-expanded", open);
        });
      });
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".nav-group")) closeAll();
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(); });
    })();
  </script>
</body>
</html>
